{
    "name": "WeSafe",
    "namespace": "WeSafe",
    "version": "25.01.0.0",
    "framework": "ext731",
    "toolkit": "classic",
    "theme": "theme-gray",
    "requires": [
        "font-awesome",
        "common",
        "ux"
    ],
    "indexHtmlPath": "index.html",
    "classpath": [
        "app",
        "${ workspace.dir}/packages/local/common/src"
    ],
    "overrides": [
        "overrides"
    ],
    "fashion": {
        "missingParameters": "error",
        "inliner": {
            "enable": false
        }
    },

    "sass": {
        "namespace": "WeSafe",
        "generated": {
            "var": "sass/save.scss",
            "src": "sass/save"
        },
        "etc": [
            "sass/etc/all.scss"
        ],
        "var": [
            "sass/var/all.scss",
            "sass/var"
        ],

        "src": [
            "sass/src"
        ]
    },

    "js": [
        {
            "path": "${framework.dir}/build/ext-all-rtl-debug.js"
        },
        {
            "path": "app.js",
            "bundle": true
        },
        {
            "path": "/js/Desktop/getDesktopData.js",
            "bundle": false,
            "remote": true
        }
    ],

    "css": [
        {
            "path": "${build.out.css.path}",
            "bundle": true,
            "exclude": ["fashion"]
        }, 
        {
            "path": "/css/desktop/FamFamFamCss.css",
            "remote": true
        }, 
        {
            "path": "/css/desktop/Desktop6Css.css",
            "remote": true
        }, 
        {
            "path": "/css/desktop/SgDesktopCss.css",
            "remote": true
        }, 
        {
            "path": "/css/desktop/UxNotificationCss.css",
            "remote": true
        }, 
        {
            "path": "/css/desktop/ClearbuttonCss.css",
            "remote": true
        }, 
        {
            "path": "/css/desktop/ImageDataViewCss.css",
            "remote": true
        }, 
        {
            "path": "/css/desktop/SoftguardCss.css",
            "remote": true
        }, 
        {
            "path": "/css/desktop/toolbarcss.css",
            "remote": true
        }
    ],

     "loader": {
         "cache": false,
         "cacheParam": "_dc"
     },

    "production": {
        "output": {
            "appCache": {
                "enable": false,
                "path": "cache.appcache"
            }
        },
        "loader": {
            "cache": "${build.timestamp}"
        },
        "cache": {
            "enable": true
        },
        "compressor": {
            "type": "yui"
        }
    },
    "testing": {
    },
    "development": {
        "watch": {
            "delay": 250
        },
        "loader": {
            "cache": true,
            "cacheParam": "_dc"
        }
    },
    "bootstrap": {
        "base": "${app.dir}",

        "microloader": "bootstrap.js",
        "css": "bootstrap.css"
    },

    "output": {
        "base": "${workspace.build.dir}/${build.environment}/${app.name}",
        "appCache": {
            "enable": false
        }
    },

    "cache": {
        "enable": false,
        "deltas": true
    },

    "appCache": {
        "cache": [
            "index.html"
        ],
        "network": [
            "*"
        ],
        "fallback": []
    },

    "resources": [
        {
            "path": "resources",
            "output": "shared"
        }
    ],

    "archivePath": "archive",

    "slicer": {
        "js": [
            {
                "path": "sass/example/custom.js",
                "isWidgetManifest": true
            }
        ],
        "output": {
            "appCache": {
                "enable": false
            }
        },
        "cache": {
            "enable": false
        }
    },

    "ignore": [
        "(^|/)CVS(/?$|/.*?$)"
    ],
     
    "id": "10002509-67a1-4c01-9e7b-453fa07b6cc8"
}
