{
    "name": "common",
    "sencha": {
        "namespace": "Common",
        "type": "code",
        "toolkit": "",
        "creator": "dedalo",
        "summary": "Clases comunes a todas las apps",
        "detailedDescription": "Long description of package",
        "version": "1.0.0",
        "compatVersion": "1.0.0",
        "format": "1",
        "slicer": {
            "js": [
                {
                    "path": "sass/example/custom.js, {package.dir}/sass/example/custom.js, ${workspace.dir}/packages/utils/MarkerClusterer.js",
                    "isWidgetManifest": true
                }
            ]
        },
        "output": "${package.dir}/build",
        "local": true,
        "sass": {
            "namespace": "common",
            "etc": [
                "${package.dir}/sass/etc/all.scss"
            ],
            "var": [
                "${package.dir}/sass/var"
            ],
            "src": [
                "${package.dir}/sass/src"
            ]
        },
        "classpath": [
            "${package.dir}/src"
        ],
        "overrides": [
            "${package.dir}/overrides"
        ],
        "example": {
            "path": [
                "${package.dir}/examples"
            ]
        },
        "framework": "ext731",
        "requires": [
            "sencha-charts",
            "charts",
            "ux"
        ]
    },
    "dependencies": {
        "common": "file:"
    }
}
