# =============================================================================
# Softguard QA Automation — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Testing mode:
#   "production" — test against gcs.softguard.com directly
#   "local"      — test against localhost (sencha watch) with API proxy to gcs
TEST_MODE=production

# --- Production settings ---
BASE_URL=https://gcs.softguard.com
LOGIN_USERNAME=
LOGIN_PASSWORD=

# Optional: skip UI login, inject this token directly (from OAuth_Token cookie).
# If set, the framework will use this token instead of performing UI login.
OAUTH_TOKEN=

# --- Local dev settings (when TEST_MODE=local) ---
LOCAL_PORT=1841
LOCAL_BASE_URL=http://localhost:1841

# --- Browser settings ---
# Browser to use: chromium, firefox, webkit
BROWSER=chromium
# Run in headed mode (true/false)
HEADED=false
