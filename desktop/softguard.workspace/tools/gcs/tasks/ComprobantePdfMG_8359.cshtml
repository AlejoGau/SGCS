					<td colspan=6><center>CAE"+ cae + @" <br> " +@Localization.GetLocale("Fecha de Vto. CAE")+" "+@vencimiento_cae+@"</center></td>
				</tr>
				<tr height=110>
					<td colspan=6><center><img src='"+_imgSrc+@"'/></center></td>
				</tr>
				";
		}

		_result += "</table>";
		return new HtmlString(_result);
	}
}
@{
	
	//Localization
	var Localization = LocalizationService.GetLocalization("WebMG");

	// Tomo parametros de URL.
	var idComprobante = Request.Params["idComprobante"];
	var token = Request.Params["oauth_token"];
