	public static String CuentasContrato (int idContrato, string token) {
		if (idContrato==0){
			return ""; 
		}

		// busco las cuentas del idContrato
		// Defino search a Utilizar
		var s = Slbf.ObjectFactoryService.Create<Slbf.Objects.SearchObject>();
		s.LoadByName("CuentaByDealer");

		//Genero Diccionario para aceptar los parametros del Store procedure
		var sd = new Dictionary<string, object>(){};

		// Cargo el diccionario con la informacion de los parametros, filters, sorts, etc.
		sd.Add("filter","[{\"property\":\"crm_contrato:RelationParent\",\"value\":\""+idContrato+"\"}]");
		sd.Add("token",token);

		int item = 0;
		// Ejecuto el Store Procedure y leo informacion
		DataTable searchdata = s.ExecuteAsDataTable(sd, out item);
		string _result="";
		if (item > 0){
			_result= "<div style=\"margin:5px\">";
			_result+= "<ul>";
			foreach (DataRow _row in searchdata.Rows){
				_result+="<li>"+_row["cue_cnombre"]+" ("+_row["cue_ccalle"]+", "+_row["cue_clocalidad"]+", "+_row["cue_provincia"]+")</li>";
			}
			_result+= "</ul>";
			_result +="</div>";
		}

		return _result;
    }

