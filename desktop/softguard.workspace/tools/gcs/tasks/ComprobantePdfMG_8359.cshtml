	/// <summary>
	/// Interpola variables {{nombre}} en un template usando un diccionario de valores.
	/// Variables sin valor se reemplazan por string vacío.
	/// </summary>
	public static string InterpolateTemplate(string template, Dictionary<string, string> vars) {
		if (string.IsNullOrEmpty(template)) return "";
		return Regex.Replace(template, @"\{\{(\w+)\}\}", m => {
			string key = m.Groups[1].Value;
			string val;
			if (vars.TryGetValue(key, out val)) return val ?? "";
			return "";
		});
	}

	/// <summary>
	/// Construye el diccionario de variables de interpolación a partir del DataRow del comprobante.
	/// </summary>
	public static Dictionary<string, string> BuildInterpolationVars(DataRow row, int itemsCount) {
		var vars = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

		// Emisor
		vars["emisor_nombre"] = row["org_cnombre"].ToString();
		vars["emisor_cuit"] = row["org_cidentificacion"].ToString();
		vars["emisor_domicilio"] = row["org_ccallefiscal"].ToString();
		vars["emisor_localidad"] = row["org_clocalidadfiscal"].ToString();
		vars["emisor_provincia"] = row["org_pro_cdescripcion"].ToString();
		vars["emisor_cp"] = row["org_ccodigopostalfiscal"].ToString();
		vars["emisor_telefono"] = row["org_ctelefono"].ToString();
		vars["emisor_email"] = row["org_cmail"].ToString();
		vars["emisor_iva"] = row["org_cat_cdescripcion"].ToString();
		vars["emisor_simbolo"] = (row.Table.Columns.Contains("mon_csymbol") ? row["mon_csymbol"].ToString() : "");

		// Cliente
		vars["cliente_nombre"] = row["nombreOrganizacion"].ToString();
		vars["cliente_cuit"] = row["cli_cidentificacion"].ToString();
		vars["cliente_iva"] = row["cli_cat_cdescripcion"].ToString();
		vars["cliente_domicilio"] = row["cli_ccallefiscal"].ToString();
		vars["cliente_localidad"] = row["cli_clocalidadfiscal"].ToString();
		vars["cliente_provincia"] = row["cli_pro_cdescripcion"].ToString();
		vars["cliente_cp"] = row["cli_ccodigopostalfiscal"].ToString();
		try { vars["cliente_telefono"] = row["cli_ctelefono"].ToString(); } catch { vars["cliente_telefono"] = ""; }
		try { vars["cliente_contacto"] = row["cli_ccontacto"].ToString(); } catch { vars["cliente_contacto"] = ""; }
		try { vars["cliente_servicio"] = row["cli_cservicio"].ToString(); } catch { vars["cliente_servicio"] = ""; }
		try { vars["cliente_observacion"] = row["cli_cobservacion"].ToString(); } catch { vars["cliente_observacion"] = ""; }
		try { vars["cliente_numero"] = row["cli_inumero"].ToString(); } catch { vars["cliente_numero"] = ""; }

		// Comprobante
		vars["comprobante_tipo"] = row["cbt_cdescripcion"].ToString();
		vars["comprobante_numero"] = row["_numeroComprobante"].ToString();
		try { vars["comprobante_fecha"] = ((DateTime)row["cbc_dfecha"]).ToString("dd/MM/yyyy"); } catch { vars["comprobante_fecha"] = row["cbc_dfecha"].ToString(); }
		vars["comprobante_subtotal"] = ((Decimal)row["cbc_ysubtotal"]).ToString("N2");
		vars["comprobante_total"] = ((Decimal)row["cbc_ytotal"]).ToString("N2");
		vars["comprobante_cae"] = row["cbc_ccae"].ToString();
		vars["comprobante_vto_cae"] = row["cbc_cvtocae"].ToString();
		vars["condicion_pago"] = row["cli_con_cdescripcion"].ToString();
		vars["cantidad_items"] = itemsCount.ToString();

		// Calculadas
		try {
			DateTime fecha = (DateTime)row["cbc_dfecha"];
			vars["periodo_facturacion"] = fecha.ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-AR"));
		} catch {
			vars["periodo_facturacion"] = "";
		}
		vars["fecha_actual"] = DateTime.Now.ToString("dd/MM/yyyy");

		return vars;
	}

	public static string ResolveInvoiceLogoUrl(string defaultBaseUrl, DataRow row, string facturaLogoUrl) {
		string logoSrc = defaultBaseUrl + "/gallery/Moneyguard/logo_" + row["orgfac_org_icodigo_id"] + ".jpg";
		if (!string.IsNullOrWhiteSpace(facturaLogoUrl)) {
			if (facturaLogoUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || facturaLogoUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase)) {
				logoSrc = facturaLogoUrl;
			} else if (facturaLogoUrl.StartsWith("/")) {
				logoSrc = defaultBaseUrl + facturaLogoUrl;
			} else {
				logoSrc = defaultBaseUrl + "/" + facturaLogoUrl;
			}
		}
		return logoSrc;
	}

	public static string SafeDynamicString(dynamic obj, string propertyName, string defaultValue = "") {
		try {
			var value = obj[propertyName];
			if (value == null) return defaultValue;
			var result = value.ToString();
			return string.IsNullOrWhiteSpace(result) ? defaultValue : result;
		} catch {
			return defaultValue;
		}
	}

	public static bool SafeDynamicBool(dynamic obj, string propertyName, bool defaultValue = false) {
		try {
			var value = obj[propertyName];
			if (value == null) return defaultValue;
			if (value is bool) return (bool)value;
			bool parsed;
			if (bool.TryParse(value.ToString(), out parsed)) return parsed;
			return defaultValue;
		} catch {
			return defaultValue;
		}
	}

	public static dynamic SafeDynamicObject(dynamic obj, string propertyName) {
		try {
			var value = obj[propertyName];
			if (value == null) return null;

			try {
				string json = value.ToString();
				if (!string.IsNullOrWhiteSpace(json) && (json.StartsWith("{") || json.StartsWith("["))) {
					return DynamicJson.Parse(json);
				}
			} catch {}

			return value;
		} catch {
			return null;
		}
	}

	public static string SanitizePaymentValue(string value) {
		if (string.IsNullOrWhiteSpace(value)) return "";
		return value.Replace("\r", " ").Replace("\n", " ").Trim();
	}

	public static string RenderPaymentMethodsHtml(dynamic integracionesPago, DataRow row, Dictionary<string, string> baseVars) {
		if (integracionesPago == null) return "";

		dynamic paymentConfig = integracionesPago;
		try {
			string rawConfig = integracionesPago.ToString();
			if (!string.IsNullOrWhiteSpace(rawConfig) && (rawConfig.StartsWith("{") || rawConfig.StartsWith("["))) {
				paymentConfig = DynamicJson.Parse(rawConfig);
			}
		} catch {}

		var blocks = new List<string>();
		var localization = LocalizationService.GetLocalization("WebMG");

		try {
			dynamic transferencia = SafeDynamicObject(paymentConfig, "transferencia");
			if (transferencia != null && SafeDynamicBool(transferencia, "habilitado")) {
				var details = new List<string>();
				var banco = SanitizePaymentValue(SafeDynamicString(transferencia, "banco"));
				var cbu = SanitizePaymentValue(SafeDynamicString(transferencia, "cbu"));
				var alias = SanitizePaymentValue(SafeDynamicString(transferencia, "alias"));
				var titular = SanitizePaymentValue(SafeDynamicString(transferencia, "titular"));
				var cuitTitular = SanitizePaymentValue(SafeDynamicString(transferencia, "cuit_titular"));

				if (!string.IsNullOrWhiteSpace(banco)) details.Add("<strong>Banco:</strong> " + banco);
				if (!string.IsNullOrWhiteSpace(cbu)) details.Add("<strong>CBU:</strong> " + cbu);
				if (!string.IsNullOrWhiteSpace(alias)) details.Add("<strong>Alias:</strong> " + alias);
				if (!string.IsNullOrWhiteSpace(titular)) details.Add("<strong>Titular:</strong> " + titular);
				if (!string.IsNullOrWhiteSpace(cuitTitular)) details.Add("<strong>CUIT:</strong> " + cuitTitular);

				if (details.Count > 0) {
					blocks.Add("<tr><td style='padding:8px 10px; border-top:1px solid #ddd; vertical-align:top; width:220px;'><strong>Transferencia bancaria</strong></td><td style='padding:8px 10px; border-top:1px solid #ddd;'>" + string.Join("<br/>", details.ToArray()) + "</td></tr>");
				}
			}
		} catch {}

		try {
			dynamic mercadopago = SafeDynamicObject(paymentConfig, "mercadopago");
			if (mercadopago != null && SafeDynamicBool(mercadopago, "habilitado")) {
				var url = SafeDynamicString(mercadopago, "url");
				var mostrarQr = SafeDynamicBool(mercadopago, "mostrar_qr");
				var html = new System.Text.StringBuilder();
				if (!string.IsNullOrWhiteSpace(url)) {
					html.Append("<strong>Link de pago:</strong> <a href='").Append(url).Append("' target='_blank'>").Append(url).Append("</a>");
				} else {
					html.Append("<strong>Link de pago:</strong> No configurado");
				}

				if (mostrarQr && !string.IsNullOrWhiteSpace(url)) {
					html.Append("<div style='margin-top:8px;'><img src='https://api.qrserver.com/v1/create-qr-code/?size=110x110&data=")
						.Append(Uri.EscapeDataString(url))
						.Append("' style='width:110px;height:110px;border:1px solid #ccc;' alt='QR Mercado Pago' /></div>");
				}

				blocks.Add("<tr><td style='padding:8px 10px; border-top:1px solid #ddd; vertical-align:top; width:220px;'><strong>Mercado Pago</strong></td><td style='padding:8px 10px; border-top:1px solid #ddd;'>" + html.ToString() + "</td></tr>");
			}
		} catch {}

		try {
			dynamic pagofacil = SafeDynamicObject(paymentConfig, "pagofacil");
			if (pagofacil != null && SafeDynamicBool(pagofacil, "habilitado")) {
				var codigoEntidad = SafeDynamicString(pagofacil, "codigo_entidad");
				var templateCodigo = SafeDynamicString(pagofacil, "template_codigo", "{{codigo_entidad}}{{cliente_numero}}");
				var paymentVars = new Dictionary<string, string>(baseVars, StringComparer.OrdinalIgnoreCase);
				paymentVars["codigo_entidad"] = codigoEntidad;
				var codigoPago = InterpolateTemplate(templateCodigo, paymentVars);
				codigoPago = SanitizePaymentValue(string.IsNullOrWhiteSpace(codigoPago) ? codigoEntidad : codigoPago);
				blocks.Add("<tr><td style='padding:8px 10px; border-top:1px solid #ddd; vertical-align:top; width:220px;'><strong>Pago Fácil</strong></td><td style='padding:8px 10px; border-top:1px solid #ddd;'><strong>Código de pago:</strong> " + codigoPago + "</td></tr>");
			}
		} catch {}

		try {
			dynamic rapipago = SafeDynamicObject(paymentConfig, "rapipago");
			if (rapipago != null && SafeDynamicBool(rapipago, "habilitado")) {
				var codigoEntidad = SafeDynamicString(rapipago, "codigo_entidad");
				var templateCodigo = SafeDynamicString(rapipago, "template_codigo", "{{codigo_entidad}}{{cliente_numero}}");
				var paymentVars = new Dictionary<string, string>(baseVars, StringComparer.OrdinalIgnoreCase);
				paymentVars["codigo_entidad"] = codigoEntidad;
				var codigoPago = InterpolateTemplate(templateCodigo, paymentVars);
				codigoPago = SanitizePaymentValue(string.IsNullOrWhiteSpace(codigoPago) ? codigoEntidad : codigoPago);
				blocks.Add("<tr><td style='padding:8px 10px; border-top:1px solid #ddd; vertical-align:top; width:220px;'><strong>Rapipago</strong></td><td style='padding:8px 10px; border-top:1px solid #ddd;'><strong>Código de pago:</strong> " + codigoPago + "</td></tr>");
			}
		} catch {}

		try {
			dynamic debitoAutomatico = SafeDynamicObject(paymentConfig, "debito_automatico");
			if (debitoAutomatico != null && SafeDynamicBool(debitoAutomatico, "habilitado")) {
				var texto = SanitizePaymentValue(SafeDynamicString(debitoAutomatico, "texto", "El importe será debitado automáticamente de su cuenta."));
				if (!string.IsNullOrWhiteSpace(texto)) {
					blocks.Add("<tr><td style='padding:8px 10px; border-top:1px solid #ddd; vertical-align:top; width:220px;'><strong>Débito automático</strong></td><td style='padding:8px 10px; border-top:1px solid #ddd;'>" + texto + "</td></tr>");
				}
			}
		} catch {}

		if (blocks.Count == 0) return "";

		var sb = new System.Text.StringBuilder();
		sb.Append("<table cellpadding='0' cellspacing='0' width='847' style='border:1px solid black; border-top:none;'>");
		sb.Append("<tr><td colspan='2' style='padding:10px; background-color:#f2f2f2; font-weight:bold;'>");
		sb.Append(localization.GetLocale("MEDIOS DE PAGO"));
		sb.Append("</td></tr>");
		foreach (var block in blocks) {
			sb.Append(block);
		}
		sb.Append("</table>");
		return sb.ToString();
	}

