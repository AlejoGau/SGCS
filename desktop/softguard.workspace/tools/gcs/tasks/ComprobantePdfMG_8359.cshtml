			preview["org_ctelefono"] = orgRow["org_ctelefono"];
			preview["org_cmail"] = orgRow["org_cmail"];
			preview["org_ccategoriaimpositiva"] = orgRow["org_ccategoriaimpositiva"];
			preview["org_cinicioactividades"] = orgRow["org_cinicioactividades"];
