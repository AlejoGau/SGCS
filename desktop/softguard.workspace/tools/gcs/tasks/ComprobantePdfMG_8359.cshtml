			preview["org_cidentificacion"] = "";
			preview["org_ccallefiscal"] = "";
			preview["org_clocalidadfiscal"] = "";
			preview["org_cprovinciafiscal"] = "";
			preview["org_ccodigopostalfiscal"] = "";
			preview["org_ctelefono"] = "";
			preview["org_cmail"] = "";
			preview["org_ccategoriaimpositiva"] = "";
			preview["org_cinicioactividades"] = "";
			preview["org_cempresacb"] = "";
			preview["org_cheadercbte"] = "";
			preview["org_pro_cdescripcion"] = "";
			preview["org_cat_cdescripcion"] = "";
			preview["org_csymbol"] = "";
			preview["orgfac_org_cmetadata"] = "";
		}

		searchdata.Rows.Add(preview);
		item = 1;

		// Items de ejemplo
		searchdataItems = new DataTable();
		searchdataItems.Columns.Add("cbi_icantidad", typeof(int));
		searchdataItems.Columns.Add("cbi_yimporte", typeof(decimal));
		searchdataItems.Columns.Add("Name", typeof(string));
		searchdataItems.Columns.Add("_total", typeof(decimal));

		DataRow previewItem1 = searchdataItems.NewRow();
		previewItem1["cbi_icantidad"] = 1;
		previewItem1["cbi_yimporte"] = 10000.00m;
		previewItem1["Name"] = "Servicio de monitoreo mensual";
		previewItem1["_total"] = 10000.00m;
		searchdataItems.Rows.Add(previewItem1);

		DataRow previewItem2 = searchdataItems.NewRow();
		previewItem2["cbi_icantidad"] = 2;
		previewItem2["cbi_yimporte"] = 2500.00m;
		previewItem2["Name"] = "Servicio adicional";
		previewItem2["_total"] = 2500.00m;
		searchdataItems.Rows.Add(previewItem2);
		itemsTotal = 2;

	} else {
		// --- MODO NORMAL: datos reales ---

		// Defino Stored procedure a Utilizar
		var s = Slbf.ObjectFactoryService.Create<Slbf.Objects.SearchObject>();
		s.LoadByName("m_comprobantes_cab_fc");

		//Genero Diccionario para aceptar los parametros del Store procedure
		var sd = new Dictionary<string, object>(){};

		// Cargo el diccionario con la informacion de los parametros, filters, sorts, etc.
		sd.Add("filter","[{\"property\":\"cbc_icodigo_id\",\"value\":\""+idComprobante+"\"}]");
		sd.Add("token",token);

		// Ejecuto el Store Procedure y leo informacion
		searchdata = s.ExecuteAsDataTable(sd, out item);

		if (!searchdata.Columns.Contains("cfc_cbonificaciontipo")) {
			searchdata.Columns.Add("cfc_cbonificaciontipo", typeof(string));
