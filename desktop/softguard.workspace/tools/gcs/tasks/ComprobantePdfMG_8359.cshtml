					"MG_ComprobanteBonificacionSel",
					new Dictionary<string, object>(){{"@IdComprobante", int.Parse(idComprobante)}}
				);
				if (bonificacionData.Rows.Count > 0) {
					var bonus = bonificacionData.Rows[0];
					searchdata.Rows[0]["cfc_cbonificaciontipo"] = bonus["cfc_cbonificaciontipo"];
					searchdata.Rows[0]["cfc_nbonificacionvalor"] = bonus["cfc_nbonificacionvalor"] == DBNull.Value ? 0.00m : bonus["cfc_nbonificacionvalor"];
					searchdata.Rows[0]["cfc_ybonificacionimporte"] = bonus["cfc_ybonificacionimporte"] == DBNull.Value ? 0.00m : bonus["cfc_ybonificacionimporte"];
					searchdata.Rows[0]["cfc_nbonificacionpermanente"] = bonus["cfc_nbonificacionpermanente"] == DBNull.Value ? 0 : bonus["cfc_nbonificacionpermanente"];
				}
			} catch (Exception e) {
				<!-- error a tomar la bonificacion @e.Message -->
			}
		}

		//items
		// Defino Stored procedure a Utilizar
		var items = Slbf.ObjectFactoryService.Create<Slbf.Objects.SearchObject>();
		items.LoadByName("m_comprobantes_item_fc");

		//Genero Diccionario para aceptar los parametros del Store procedure
		var sdItems = new Dictionary<string, object>(){};

		// Cargo el diccionario con la informacion de los parametros, filters, sorts, etc.
		sdItems.Add("filter","[{\"property\":\"cbi_iCodigoCab\",\"value\":\""+idComprobante+"\"}]");
		
		// Ejecuto el Store Procedure y leo informacion
		searchdataItems = items.ExecuteAsDataTable(sdItems, out itemsTotal);
	}
}
<!doctype html>
<HTML>
	<HEAD>
		<meta charset='UTF-8'/>
		<meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
		<link rel="stylesheet" href="/css/SgAppWebReport/css.boostrap.min.css" type="text/css" media="all" />
	</HEAD>
	<body>

		
		@if(searchdata.Rows.Count >0 ) {
			DataRow _row = searchdata.Rows[0];

			// preparo la metatada de la organizacion facturadora
			string orgfac_org_cmetadata = _row["orgfac_org_cmetadata"].ToString();
			if (isPreview && !string.IsNullOrWhiteSpace(previewMetadata)) {
				orgfac_org_cmetadata = previewMetadata;
			}
			dynamic dorgfac_org_cmetadata = null;
			string informacionExtra = "";
			string observacionesTemplate = "";
			string footerFijo = "";
			string facturaLogoUrl = "";
			dynamic integracionesPago = null;
			try{
				if (!string.IsNullOrEmpty(orgfac_org_cmetadata)){
					dorgfac_org_cmetadata = DynamicJson.Parse(orgfac_org_cmetadata);
					try { informacionExtra = dorgfac_org_cmetadata["informacionExtra"].ToString(); } catch {}
					// DK-1493: Leer configuración de factura
					try {
						dynamic factura = dorgfac_org_cmetadata["factura"];
						if (factura != null) {
							try { observacionesTemplate = factura["observaciones_template"].ToString(); } catch {}
							try { footerFijo = factura["footer_fijo"].ToString(); } catch {}
							try { facturaLogoUrl = factura["logo_url"].ToString(); } catch {}
							try { integracionesPago = SafeDynamicObject(factura, "integraciones_pago"); } catch {}
						}
					} catch {}
				}
			} catch (Exception e){
				<!-- error a tomar la metadata @e.Message -->
			}

			// DK-1493: Construir diccionario e interpolar templates
			var interpolationVars = BuildInterpolationVars(_row, itemsTotal);
			string observacionesHtml = InterpolateTemplate(observacionesTemplate, interpolationVars);
			string mediosPagoHtml = RenderPaymentMethodsHtml(integracionesPago, _row, interpolationVars);
			string footerHtml = InterpolateTemplate(footerFijo, interpolationVars);

			if (isPreview) {
				<div style="background-color: #fff3cd; border: 1px solid #ffc107; padding: 8px; margin-bottom: 10px; width: 847px; text-align: center; font-weight: bold;">
					VISTA PREVIA — Los datos del cliente y comprobante son de ejemplo
				</div>
			}

			@header(_row, false, facturaLogoUrl);

			@client(_row);
			if(itemsTotal>0){ 
				<table border=1 cellpadding=0 cellspacing=0 width=847>
					<tr height=50>
						<td colspan=6> @Localization.GetLocale("CONDICION DE VENTA"): @_row["cli_con_cdescripcion"]</td>
					</tr>
				
					<tr height=50 class="header-items">
						<td> @Localization.GetLocale("CANTIDAD")</td>
						<td colspan=3> @Localization.GetLocale("DESCRIPCION")</td>
						<td> @Localization.GetLocale("VALOR UNITARIO")</td>
						<td> @Localization.GetLocale("VALOR TOTAL")</td>
					</tr>
					<tr colspan="4" height="480">
						<td colspan="12" valign="top">
							<table>
								<tbody>
									@foreach(DataRow _comprobanteItem in searchdataItems.Rows){
										if(int.Parse(_row["cbt_nCbteCAE"].ToString()) == 6 || int.Parse(_row["cbt_nCbteCAE"].ToString()) == 11){
											@WithItems(_comprobanteItem)
										}else{
											@WithItemsSubtotal(_comprobanteItem)
										}
									}
								</tbody>
							</table>
						<td>
					</tr>
				</table>
				
			}else{
				@WithOutItems(_row["cli_con_cdescripcion"])
			}
			decimal descuentoAplicado = 0.00m;
			try { descuentoAplicado = Convert.ToDecimal(_row["cfc_ybonificacionimporte"]); } catch {}
			decimal subtotalCabecera = 0.00m;
			try { subtotalCabecera = Convert.ToDecimal(_row["cbc_ysubtotal"]) + descuentoAplicado; } catch { subtotalCabecera = Convert.ToDecimal(_row["cbc_ysubtotal"]); }
			string descuentoTexto = descuentoAplicado > 0 ? descuentoAplicado.ToString("0.00") : "";
			try{
				@footer(_row["cbc_ytotal"],descuentoTexto,@_row["cbc_ccae"],@_row["cbc_cvtocae"],subtotalCabecera,@_row["cbc_yimpuesto1"],@_row["cbc_yimpuesto2"],@_row["cbc_yimpuesto3"],_row)
			}catch (Exception e){
				// definir que mostrar y por que del error
				<P>Error al generar el Footer : @e.Message</P>
			}

			// DK-1493: Sección de observaciones (después de totales)
			if (!string.IsNullOrEmpty(observacionesHtml)){
				<table cellpadding=0 cellspacing=0 width=847 style="border:1px solid black; border-top: none;">
					<tr>
						<td style="padding: 10px;">
							<strong>@Localization.GetLocale("OBSERVACIONES"):</strong><br/>
							@Html.Raw(observacionesHtml.Replace("\n", "<br/>"))
						</td>
					</tr>
				</table>
			}

			// DK-1494: Medios de pago configurables por organización facturadora
			if (!string.IsNullOrEmpty(mediosPagoHtml)) {
				@Html.Raw(mediosPagoHtml)
			}
			// DK-1493: Footer fijo (al pie de la factura)
			if (!string.IsNullOrEmpty(footerHtml)){
				<div style="width: 847px; border-top: 1px solid #999; margin-top: 10px; padding-top: 5px; font-size: 11px; color: #555;">
					@Html.Raw(footerHtml.Replace("\n", "<br/>"))
				</div>
			}

			// DK-1493: QR AFIP (si mostrar_qr_afip = true y hay CAE)
			bool mostrarQrAfip = false;
			try {
				if (dorgfac_org_cmetadata != null) {
					var qrFacData = dorgfac_org_cmetadata["factura"];
					if (qrFacData != null) {
						try { mostrarQrAfip = (bool)qrFacData["mostrar_qr_afip"]; } catch {}
					}
				}
			} catch {}
			string caeValue = "";
			try { caeValue = _row["cbc_ccae"] != null ? _row["cbc_ccae"].ToString() : ""; } catch {}
			if (mostrarQrAfip && !string.IsNullOrWhiteSpace(caeValue)) {
				string cuitQr = "";
				try { cuitQr = _row["org_cidentificacion"].ToString().Replace("-",""); } catch {}
				string qrData = string.Format("https://serviciosweb.afip.gob.ar/genericos/comprobantes/cae.aspx?cuit={0}&cae={1}", cuitQr, caeValue);
				string vtoQr = "";
				try { vtoQr = _row["cbc_cvtocae"].ToString(); } catch {}
				<div style="width: 847px; margin-top: 8px; padding: 5px 0; display: flex; align-items: center; gap: 10px; border-top: 1px solid #ddd;">
					<img src="https://api.qrserver.com/v1/create-qr-code/?size=80x80&data=@(Uri.EscapeDataString(qrData))"
					     style="width:80px;height:80px;border:1px solid #ccc;"
					     alt="QR AFIP" />
					<div style="font-size:10px;color:#666;">
						<strong>Comprobante autorizado por AFIP</strong><br/>
						CAE: @caeValue<br/>
						Vto. CAE: @vtoQr
					</div>
				</div>
			}

			if (!string.IsNullOrEmpty(informacionExtra)){
				int cfc_cntiid = 0;
				int.TryParse(_row["cfc_cntiid"].ToString(), out cfc_cntiid);
				if (informacionExtra.Contains("{ACCOUNTLIST}")){
					string ACCOUNTLIST = CuentasContrato(cfc_cntiid, token);
					informacionExtra = informacionExtra.Replace("{ACCOUNTLIST}",ACCOUNTLIST);
				}
				<div  style="page-break-before:always;">
					@header(_row, true, facturaLogoUrl)
					<div style ="border:1px black solid; width:847px; height:480px; padding: 5px" >
						@Html.Raw(informacionExtra)
					</div>
				</div>
			}
			
		}
		 else {
			<h1>@Localization.GetLocale("No hay comprobantes para mostrar")</h1>
		}

		<script>
			function printMe() {
				window.print()
			}
		</script>
		<style>
			.money {
				text-align: right;
			}
			.comprobante_item td {
				padding: 5px;
			}
			.header-items td {
				background-color: lightgrey;
				text-align: center;
				font-weight: bold;
			}
		</style>
	</body>
</HTML>
