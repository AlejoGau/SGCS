		}
		if (!searchdata.Columns.Contains("cfc_ybonificacionimporte")) {
			searchdata.Columns.Add("cfc_ybonificacionimporte", typeof(decimal));
		}
		if (!searchdata.Columns.Contains("cfc_nbonificacionpermanente")) {
			searchdata.Columns.Add("cfc_nbonificacionpermanente", typeof(int));
		}

		if (searchdata.Rows.Count > 0 && !string.IsNullOrEmpty(idComprobante)) {
